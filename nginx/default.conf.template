# 由 nginx 官方镜像 entrypoint 在启动时 envsubst 渲染。
# 纯静态托管；/v1/soccer/ws 的 WebSocket 反代已上移到边缘 Caddy，这里不再处理。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 探针（容器 HEALTHCHECK / compose healthcheck 用）
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 挂在 /livetracker/ 子路径下：构建产物引用 /livetracker/assets/...，
    # 磁盘上仍是 assets/...，这里把前缀剥离后映射回文件。
    location /livetracker/assets/ {
        rewrite ^/livetracker(/.*)$ $1 break;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /livetracker/ {
        rewrite ^/livetracker(/.*)$ $1 break;
        try_files $uri $uri/ /index.html;
    }

    # 兜底：直接访问根时也回落到 SPA
    location / {
        try_files $uri $uri/ /index.html;
    }
}
