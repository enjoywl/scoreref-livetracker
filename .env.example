# Wasabi image credentials (required for team/league/player crests)
# Get these from your Wasabi account / existing deployment.
VITE_WASABI_ACCESS_KEY=your_access_key
VITE_WASABI_SECRET_KEY=your_secret_key

# Option A: explicit endpoint + bucket
VITE_WASABI_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com
VITE_WASABI_BUCKET=soccer-cn

# Option B: let the frontend discover endpoint/bucket from the API
# (access/secret keys are still required for presigning)
# VITE_API_BASE_URL=https://api.example.com
